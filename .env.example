# Database Connection (Neon Cloud PostgreSQL)
DATABASE_URL="your_database_url"

# Store Information
NEXT_PUBLIC_STORE_NAME="Angel Collection"
NEXT_PUBLIC_STORE_SLOGAN="Elegance Redefined"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"

# Master Admin Credentials
OWNER_EMAIL="your_email@example.com"
OWNER_PASSWORD="your_secure_password_here"

# Payment Gateways (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_secret_key"

# Auth Secret & App URL
NEXTAUTH_SECRET="generate_a_random_secret"
NEXTAUTH_URL="http://localhost:3000"

# Admin Key
ADMIN_SECRET_KEY="your_admin_secret"
